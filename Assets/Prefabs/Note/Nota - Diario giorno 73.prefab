    - target: {fileID: 8212517616693407837, guid: 6edd8d89b76d3494f875ef5fdd75c19e, type: 3}
      propertyPath: m_text
      value: "Giorno 73\n\r\nMaria non mi risponde pi\xF9, non viene pi\xF9 a trovarmi\u2026
        Eppure pensavo che i rumori dentro la struttura\r\nechi nel buio\r\nombre,
        ombre che prendono il loro aspetto\u2026 MI OSSERVANO sento i loro sussurri,
        DICONO CHE STANNO VENENDO PER ME\r\nNon possono avermi scoperto, non ho fatto
        errori.\r\nIl telefono si \xE8 rotto cadendo nel liquido del macchinario,
        l\u2019orologio era fermo gi\xE0 da un paio di giorni, ma non posso rischiare
        uscendo da qui\u2026"
      objectReference: {fileID: 0}
