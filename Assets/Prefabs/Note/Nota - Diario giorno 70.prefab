    - target: {fileID: 630093634353443479, guid: 1676769d16fe117459c4bd9db41b39ea, type: 3}
      propertyPath: m_text
      value: "Giorno 70\n\r\nHo pensato a varie parole, frasi che potessero portarlo
        a comprendere me e ci\xF2 che ho fatto.\r\nTralascier\xF2 ogni dettaglio,
        solo ci\xF2 che \xE8 necessario. Il suo legame con Maria gli dimostrer\xE0
        il senso dietro il mio operato, gli dar\xE0 una motivazione in pi\xF9 per
        portare a termine la mia opera.\r\nMio figlio la porter\xE0 a termine, DEVE
        FARLO"
      objectReference: {fileID: 0}
