    - target: {fileID: 7171863007296160029, guid: 8692138a9a824d1438286ca3253c7821, type: 3}
      propertyPath: m_text
      value: "Giorno 12\n\r\nIl laboratorio prende forma. \nHo isolato le pareti,
        installato generatori e ho iniziato a costruire i primi\r                               
        macchinari.                                                                                  
        Quattro dispositivi: \nuno per l\u2019anima, uno per il corpo, uno per la
        mente, uno per la \r\nmemoria. \nLazarus li fonder\xE0. \n\nOgni saldatura
        \xE8 una preghiera, ogni impulso un battito del mio cuore.\r\n"
      objectReference: {fileID: 0}
