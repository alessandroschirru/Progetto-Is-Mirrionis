  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Cinque bestie attendono il giudizio,\r\nognuna spinta da istinti antichi.\r\n\r\nPer
    primo avanza colui che imita l\u2019uomo,\r\nle sue mani curiose aprono il cammino.\r\n\r\nSegue
    il destriero, fedele e cieco,\r\nche corre anche verso l'abisso se guidato.\r\n\r\nDall\u2019alto
    vigila l\u2019orgoglio alato,\r\nche mai cammina, ma sempre osserva.\r\n\r\nPoi
    viene la fame che tutto mastica,\r\ntra rocce e campane, la sua voce risuona.\r\n\r\nUltimo
    striscia colui che non ha arti,\r\nma il veleno della verit\xE0 nelle sue fauci."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c5e1a28784083a143afaf6046d6d08b6, type: 2}
